# Public site facts live in config/site.ts.
# Visitor dashboard password. The tracker server defaults to aaaa when this is unset.
DASHBOARD_PASSWORD=aaaa
# Optional public origin of the tracker API, used by the GitHub Pages build.
# Leave empty until that server is deployed. Example:
# NEXT_PUBLIC_ANALYTICS_ORIGIN=https://monkeys.example.com
# ALLOWED_ORIGINS=https://aaaa-web-deploy.github.io
